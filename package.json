{
  "name": "simmer-mosquito",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "nx run-many -t build",
    "build:ts7": "nx run-many -t build:ts7",
    "db:migrate": "dbmate --migrations-dir packages/db/migrations --schema-file packages/db/schema.sql up",
    "db:rollback": "dbmate --migrations-dir packages/db/migrations --schema-file packages/db/schema.sql rollback",
    "db:status": "dbmate --migrations-dir packages/db/migrations --schema-file packages/db/schema.sql status",
    "dev:server": "nx dev @simmer-mosquito/server",
    "dev:worker": "nx dev @simmer-mosquito/worker",
    "graph": "nx graph",
    "nx": "nx",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "typecheck:ts7": "nx run-many -t typecheck:ts7"
  },
  "devDependencies": {
    "@nx/js": "22.7.1",
    "@typescript/native-preview": "beta",
    "@types/node": "25.6.0",
    "dbmate": "^2.28.0",
    "nx": "22.7.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
