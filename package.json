{
	"name": "simmer-mosquito",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"scripts": {
		"build": "nx run-many -t build",
		"build:ts7": "nx run-many -t build:ts7",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"db:migrate": "dbmate --migrations-dir packages/db/migrations --schema-file packages/db/schema.sql up",
		"db:rollback": "dbmate --migrations-dir packages/db/migrations --schema-file packages/db/schema.sql rollback",
		"db:status": "dbmate --migrations-dir packages/db/migrations --schema-file packages/db/schema.sql status",
		"dev:server": "nx dev @simmer-mosquito/server",
		"dev:admin": "nx dev @simmer-mosquito/admin",
		"dev:caddy": "caddy run --config Caddyfile.local --adapter caddyfile",
		"dev:preview": "nx dev @simmer-mosquito/preview",
		"dev:web": "nx dev @simmer-mosquito/web",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"graph": "nx graph",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"nx": "nx",
		"test": "nx run-many -t test",
		"typecheck": "nx run-many -t typecheck",
		"typecheck:ts7": "nx run-many -t typecheck:ts7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@nx/js": "22.7.1",
		"@tanstack/intent": "^0.0.41",
		"@types/node": "25.6.0",
		"@typescript/native-preview": "beta",
		"dbmate": "^2.28.0",
		"nx": "22.7.1",
		"tsx": "4.21.0",
		"typescript": "6.0.3",
		"vitest": "4.1.5"
	},
	"dependencies": {
		"@tanstack/db": "^0.6.6"
	}
}
