{
	"name": "simmer-mosquito",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"scripts": {
		"build": "nx run-many -t build",
		"changeset": "changeset",
		"changeset:status": "changeset status --since=origin/staging",
		"check": "biome check .",
		"check:acknowledgements": "node scripts/check-acknowledgements.mjs",
		"check:build-graph": "node scripts/check-build-graph.mjs",
		"check:command-columns": "node scripts/check-command-columns.mjs",
		"check:geometry-policies": "node scripts/check-geometry-policies.mjs",
		"check:schema-drift": "node scripts/check-schema-drift.mjs",
		"check:search-corpus": "node scripts/check-search-corpus.mjs",
		"check:table-types": "node scripts/generate-table-types.mjs --check",
		"check:tileset-keys": "node scripts/check-tileset-keys.mjs",
		"check:write-references": "node scripts/check-write-references.mjs",
		"check:write": "biome check --write .",
		"db:migrate": "dbmate --migrations-dir packages/db/migrations --schema-file packages/db/schema.sql up",
		"db:rollback": "dbmate --migrations-dir packages/db/migrations --schema-file packages/db/schema.sql rollback",
		"db:status": "dbmate --migrations-dir packages/db/migrations --schema-file packages/db/schema.sql status",
		"dev": "nx daemon --start && mprocs",
		"dev:server": "nx dev @simmer-mosquito/server",
		"dev:admin": "nx dev @simmer-mosquito/admin",
		"dev:caddy": "caddy run --config Caddyfile.local --adapter caddyfile",
		"dev:mobile": "nx dev @simmer-mosquito/mobile",
		"dev:preview": "nx dev @simmer-mosquito/preview",
		"dev:web": "nx dev @simmer-mosquito/web",
		"fallow": "node scripts/fallow.mjs",
		"fallow:baseline": "node scripts/fallow.mjs health --save-baseline .fallow-baseline/health.json",
		"fallow:health": "node scripts/fallow.mjs health --baseline .fallow-baseline/health.json --fail-on-regression",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"graph": "nx graph",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"nx": "nx",
		"release:version": "node scripts/release-version.mjs",
		"test": "nx run-many -t test",
		"typecheck": "nx run-many -t typecheck",
		"generate:schemas": "node scripts/generate-table-schemas.mjs",
		"generate:table-types": "node scripts/generate-table-types.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@changesets/cli": "^2.31.1",
		"@nx/js": "22.7.1",
		"@simmer-mosquito/design-tokens": "workspace:*",
		"@types/node": "25.6.0",
		"dbmate": "^2.28.0",
		"fallow": "3.14.0",
		"fallow-type-aware": "3.14.0",
		"mprocs": "^0.9.6",
		"nx": "22.7.1",
		"tsx": "4.21.0",
		"typescript": "7.0.2",
		"vitest": "4.1.5"
	},
	"dependencies": {
		"@tanstack/db": "^0.7.2",
		"pg": "^8.16.0"
	},
	"pnpm": {
		"packageExtensions": {
			"@nx/js": {
				"dependencies": {
					"typescript": "6.0.3"
				}
			},
			"nx": {
				"dependencies": {
					"typescript": "6.0.3"
				}
			}
		}
	}
}
