# Browser origins, as the app is actually reached. These are the direct Vite
# ports; behind the local Caddy front (`pnpm dev:caddy`) they become
# https://localhost:5175 (web) and https://localhost:5176 (admin), and both
# must be updated together with VITE_SERVER_URL below — the server matches
# these against the request origin for CORS and redirects.
APP_ORIGIN=http://localhost:5173
ADMIN_APP_ORIGIN=http://localhost:5174
DATABASE_URL=postgres://postgres:postgres@localhost:55432/simmer_mosquito?sslmode=disable
ELECTRIC_URL=http://localhost:3001/v1/shape
# Set only when Electric runs with ELECTRIC_SECRET (e.g. a Railway-hosted Electric
# exposed on a public domain). The server folds it into ELECTRIC_URL as a `secret`
# query param on every upstream shape request. Leave unset for local Docker
# Electric (ELECTRIC_INSECURE=true).
# ELECTRIC_SECRET=
GEOCODIO_API_KEY=
HOST=0.0.0.0
PORT=3000
# The WorkOS organization that IS SIMMER, per environment. There is exactly one,
# and a session in it is what "operator" means — the server admits it to every
# /admin/* endpoint and admits nothing else, including the same person while they
# are signed in to an agency they administer. Unset refuses everyone.
SIMMER_OPERATOR_ORG_ID=org_...
# The same organization, given to the operator console so it can answer WorkOS's
# organization challenge with it instead of showing a picker. Local dev points at
# staging WorkOS, so use the staging organization id for both.
VITE_SIMMER_OPERATOR_ORG_ID=org_...
VITE_SERVER_URL=http://localhost:3000
# Names the deployment for the two static images. Only the exact string
# `staging` does anything: it draws the environment banner in both apps.
#
# Do not set it here. The banner tells the reader that identity writes are
# refused, which is true on staging and false on your machine, because
# WORKOS_IDENTITY_WRITES_DISABLED is a staging variable. A banner that names
# a rule nothing enforces is worse than no banner. To look at it for one run:
#
#   $env:VITE_SIMMER_ENVIRONMENT = "staging"; pnpm dev:web
# Optional local HTTPS/HTTP2 proxy for browser shape streams. Point this at a
# Caddy listener that proxies the API server, not Electric directly.
# VITE_SHAPE_SERVER_URL=https://localhost:3002
WORKOS_API_KEY=sk_example
WORKOS_CLIENT_ID=client_example
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-characters
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# --- DEV-ONLY auth bypass -----------------------------------------------------
# When developing against a CLONE of the production database (so WorkOS is not
# reachable), set BOTH ids below to make every local request authenticate as a
# fixed user + organization. Get the ids from your cloned DB:
#
#   select p.display_name, m.role, u.workos_user_id, o.workos_organization_id
#   from memberships m
#   join users u on u.id = m.user_id
#   join organizations o on o.id = m.organization_id
#   join profiles p on p.id = m.profile_id
#   where m.status = 'active';
#
# Ignored unless NODE_ENV != production (fails closed). Never set in a deploy.
# DEV_IMPERSONATE_WORKOS_USER_ID=user_...
# DEV_IMPERSONATE_WORKOS_ORG_ID=org_...
# DEV_IMPERSONATE_EMAIL=you@example.com            # optional; impersonate as an operator by pointing DEV_IMPERSONATE_WORKOS_ORG_ID at SIMMER_OPERATOR_ORG_ID
# DEV_IMPERSONATE_DISPLAY_NAME=Dev Impersonation   # optional
