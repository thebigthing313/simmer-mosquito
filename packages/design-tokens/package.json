{
	"name": "@simmer-mosquito/design-tokens",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./tokens.css": "./src/tokens.css",
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"scripts": {
		"build": "tsgo -b",
		"build:ts6": "tsc -b",
		"build:ts7": "tsgo -b",
		"test": "vitest run src --passWithNoTests",
		"typecheck": "tsgo -p tsconfig.json --noEmit --pretty false",
		"typecheck:ts6": "tsc -p tsconfig.json --noEmit --pretty false",
		"typcheck:ts6": "tsc -p tsconfig.json --noEmit --pretty false",
		"typecheck:ts7": "tsgo -p tsconfig.json --noEmit --pretty false"
	},
	"types": "./dist/index.d.ts"
}
