{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
		"types": ["node"]
	},
	"include": ["src/**/*.ts"],
	"references": [
		{
			"path": "../domain"
