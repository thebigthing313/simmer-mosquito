{
	"name": "@simmer-mosquito/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./test-support": {
			"types": "./dist/test-support/db-integration.d.ts",
			"import": "./dist/test-support/db-integration.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"scripts": {
		"build": "tsgo -b",
		"build:ts6": "tsc -b",
		"build:ts7": "tsgo -b",
		"seed:sync-baseline": "tsx src/seed-sync-baseline.ts",
		"test": "vitest run --passWithNoTests",
		"typecheck": "tsgo -p tsconfig.json --noEmit --pretty false",
		"typecheck:ts6": "tsc -p tsconfig.json --noEmit --pretty false",
		"typcheck:ts6": "tsc -p tsconfig.json --noEmit --pretty false",
		"typecheck:ts7": "tsgo -p tsconfig.json --noEmit --pretty false"
	},
	"dependencies": {
		"kysely": "^0.28.0",
		"pg": "^8.16.0"
	},
	"devDependencies": {
		"@types/pg": "^8.15.0",
		"kysely-codegen": "^0.18.0"
	},
	"types": "./dist/index.d.ts"
}
