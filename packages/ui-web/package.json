{
	"name": "@simmer-mosquito/ui-web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./components/*": {
			"types": "./src/components/*.tsx",
			"import": "./src/components/*.tsx"
		},
		"./hooks/*": {
			"types": "./src/hooks/*.ts",
			"import": "./src/hooks/*.ts"
		},
		"./icons/*": {
			"types": "./src/icons/*.ts",
			"import": "./src/icons/*.ts"
		},
		"./lib/*": {
			"types": "./src/lib/*.ts",
			"import": "./src/lib/*.ts"
		},
		"./styles.css": "./src/styles.css",
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"scripts": {
		"build": "tsc -b",
		"build:ts7": "tsgo -b",
		"test": "vitest run src --passWithNoTests",
		"typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
		"typecheck:ts7": "tsgo -p tsconfig.json --noEmit --pretty false"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@base-ui/react": "^1.4.1",
		"@hookform/resolvers": "^5.2.2",
		"@simmer-mosquito/design-tokens": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"lucide-react": "^1.16.0",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.6",
		"react-hook-form": "^7.76.0",
		"react-resizable-panels": "^4.11.1",
		"recharts": "3.8.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3"
	}
}
