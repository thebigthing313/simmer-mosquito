{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"outDir": "dist",
		"rootDir": "src",
		"tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"references": [
		{
			"path": "../design-tokens"
		}
	]
}
