{
	"name": "@simmer-mosquito/sync",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"fallow": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./contract": {
			"fallow": "./src/contract.ts",
			"types": "./dist/contract.d.ts",
			"import": "./dist/contract.js"
		},
		"./session-fetch": {
			"fallow": "./src/collections/functions/session-fetch.ts",
			"types": "./dist/collections/functions/session-fetch.d.ts",
			"import": "./dist/collections/functions/session-fetch.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"scripts": {
		"build": "tsc -b",
		"test": "vitest run src --passWithNoTests",
		"typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
	},
	"dependencies": {
		"@tanstack/db": "^0.7.2",
		"@tanstack/electric-db-collection": "0.3.18",
		"zod": "^4.4.3"
	},
	"types": "./dist/index.d.ts",
	"devDependencies": {
		"@simmer-mosquito/db": "workspace:*"
	}
}
