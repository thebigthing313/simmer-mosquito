{
	"name": "@simmer-mosquito/sync",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"scripts": {
		"build": "tsgo -b",
		"build:ts6": "tsc -b",
		"build:ts7": "tsgo -b",
		"test": "vitest run src --passWithNoTests",
		"typecheck": "tsgo -p tsconfig.json --noEmit --pretty false",
		"typecheck:ts6": "tsc -p tsconfig.json --noEmit --pretty false",
		"typcheck:ts6": "tsc -p tsconfig.json --noEmit --pretty false",
		"typecheck:ts7": "tsgo -p tsconfig.json --noEmit --pretty false"
	},
	"dependencies": {
		"@tanstack/db": "^0.6.14",
		"@tanstack/electric-db-collection": "0.3.12"
	},
	"types": "./dist/index.d.ts"
}
