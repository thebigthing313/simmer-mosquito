{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM"],
		"outDir": "dist",
		"rootDir": "src",
		"tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
		// For `tests/unit/contract.test.ts` alone, which reads the package's own
		// source to walk what the `./contract` entry imports. Nothing under `src`
		// outside `src/tests` may name a Node builtin: this package runs in a
		// browser and in React Native, and `lib` above says so.
		"types": ["node"]
	},
	"include": ["src/**/*.ts"],
	// `drift.test.ts` reads the Kysely table types to check the generated schemas
	// against them, and `include` compiles it like any other source file — so the
	// build needs `packages/db` emitted first. `nx run-many` ordered it from the
	// package.json dependency and hid the gap; `pnpm --filter <app> build`, which
	// is what every Dockerfile runs, has only this to go on.
	"references": [
		{
			"path": "../db"
		}
	]
}
