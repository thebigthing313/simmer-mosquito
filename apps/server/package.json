{
	"name": "@simmer-mosquito/server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -b",
		"check:role-ladder": "tsx src/check-role-ladder.ts",
		"dev": "node --import tsx src/dev/run-dev-server.ts",
		"start": "node dist/main.js",
		"test": "vitest run --passWithNoTests",
		"typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
	},
	"dependencies": {
		"@hono/node-server": "^1.14.0",
		"@simmer-mosquito/auth": "workspace:*",
		"@simmer-mosquito/config": "workspace:*",
		"@simmer-mosquito/db": "workspace:*",
		"@simmer-mosquito/domain": "workspace:*",
		"@simmer-mosquito/sync": "workspace:*",
		"hono": "^4.7.0"
	}
}
