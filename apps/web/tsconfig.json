{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		// Deliberately outside `dist`: that directory is copied wholesale into
		// the static image and served, and build metadata names every local
		// source path. Under `node_modules` rather than the project root so Nx
		// does not see a file that changes on every build as a cache input.
		"tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
		"types": ["vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
	"references": [
		{
			"path": "../../packages/ui-web"
		},
		{
			"path": "../../packages/sync"
		},
		{
			"path": "../../packages/domain"
		},
		{
			"path": "../../packages/mapping"
		},
		{
			"path": "../../packages/auth"
		}
	]
}
