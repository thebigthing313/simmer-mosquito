{
	"name": "@simmer-mosquito/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsgo -b && vite build",
		"build:ts6": "tsc -b && vite build",
		"build:ts7": "tsgo -b && vite build",
		"dev": "vite --host 0.0.0.0 --port 5173",
		"preview": "vite preview --host 0.0.0.0 --port 4173",
		"start": "node scripts/preview.mjs",
		"test": "vitest run --passWithNoTests",
		"typecheck": "tsgo -p tsconfig.json --noEmit --pretty false",
		"typecheck:ts6": "tsc -p tsconfig.json --noEmit --pretty false",
		"typcheck:ts6": "tsc -p tsconfig.json --noEmit --pretty false",
		"typecheck:ts7": "tsgo -p tsconfig.json --noEmit --pretty false"
	},
	"dependencies": {
		"@fontsource/poppins": "^5.2.7",
		"@simmer-mosquito/domain": "workspace:*",
		"@simmer-mosquito/mapping": "workspace:*",
		"@simmer-mosquito/sync": "workspace:*",
		"@simmer-mosquito/ui-web": "workspace:*",
		"@tanstack/db": "^0.6.6",
		"@tanstack/react-db": "^0.1.84",
		"@tanstack/react-form": "^1.32.0",
		"@tanstack/react-query": "^5.100.14",
		"@tanstack/react-router": "^1.170.4",
		"mapbox-gl": "^3.24.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"recharts": "3.8.0",
		"sonner": "^2.0.7"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/react-query-devtools": "5.100.14",
		"@tanstack/router-plugin": "1.168.6",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"vite": "^8.0.10"
	}
}
